---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🧶 knitting_image_maker ガイド</h1>
			<p>
				<strong>knitting_image_maker</strong> は、ニット編み図の画像を生成するための Python ライブラリです。
				このサイトでは、インストール方法から基本的な使い方・応用テクニックまでを解説しています。
			</p>
			<p>
				ソースコードは
				<a href="https://github.com/KojiKobayashi/knitting_image_maker" target="_blank">
					GitHub（KojiKobayashi/knitting_image_maker）
				</a>
				で公開されています。
			</p>
			<p>
				<a href={`${import.meta.env.BASE_URL}blog`} class="button">📖 記事一覧を見る</a>
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 2em 1em;
	}
	.button {
		display: inline-block;
		margin-top: 1em;
		padding: 0.6em 1.4em;
		background: var(--accent);
		color: #fff;
		border-radius: 4px;
		text-decoration: none;
		font-weight: bold;
	}
	.button:hover {
		background: var(--accent-dark);
	}
</style>
