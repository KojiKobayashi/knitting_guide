---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="ja">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>🧶 knitting_image_maker ガイド</h1>
			<p>
				<strong>knitting_image_maker</strong> は、ニット編み図の画像を生成するための webアプリケーションです。
				このサイトでは、基本的な使い方から、応用的なカスタマイズ方法までを解説しています。
			</p>
			<p>
				<a href={`${import.meta.env.BASE_URL}blog`} class="button">📖 記事一覧を見る</a>
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		max-width: 720px;
		margin: 0 auto;
		padding: 2em 1em;
	}
	.button {
		display: inline-block;
		margin-top: 1em;
		padding: 0.6em 1.4em;
		background: var(--accent);
		color: #fff;
		border-radius: 4px;
		text-decoration: none;
		font-weight: bold;
	}
	.button:hover {
		background: var(--accent-dark);
	}
</style>
